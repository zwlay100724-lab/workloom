# DocMind 本地直跑（不用 Docker）时的配置模板
#
#   cp docmind/.env.example docmind/.env
#
# 只包含 DocMind Settings 认识的字段；不要加入 JWT 之外的 TaskFlow 字段。
# 真实 .env 已被 .gitignore 忽略，绝不要提交。

# 当前使用本机 5432 的 docmind 库（方案 A）。
# 如果改用 Docker 的 pgvector 容器（5433），把端口和账号改成 5433 / docmind。
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/docmind
REDIS_URL=redis://localhost:6380/0

# 必须和 taskflow/.env 中的 JWT_SECRET_KEY 完全一致
JWT_SECRET_KEY=replace-with-a-long-random-string

LLM_API_KEY=sk-replace-me
LLM_MODEL_ID=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5

EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_ID=text-embedding-v4
EMBED_API_KEY=sk-replace-me
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_DIMENSION=1024

CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K=4

# ── 后台索引队列（Redis，REDIS_URL 指向的实例）──
# 失败重试次数（含第一次）、退避基数、崩溃遗留判定分钟数
# INDEX_MAX_ATTEMPTS=3
# INDEX_RETRY_BASE_DELAY_SECONDS=5
# INDEX_STALE_MINUTES=10

# ── 跨服务事件（DocMind → TaskFlow）──
# 默认复用 REDIS_URL 指向的队列 Redis；也可以用 EVENT_REDIS_URL 单独指定。
# EVENT_REDIS_URL=redis://localhost:6380/0
# EVENT_QUEUE_NAME=workloom:events:taskflow
# EVENT_CONSUME_QUEUE_NAME=workloom:events:docmind

# 吊销 / 配额共享状态；默认回退到 REDIS_URL。
# SHARED_REDIS_URL=redis://localhost:6380/0
# AUTH_FAIL_CLOSED=false

# 配额兜底值（TaskFlow 登录时会写入用户自己的上限）。
# DEFAULT_MONTHLY_TOKEN_QUOTA=1000000
# RAG_ESTIMATED_TOKENS=2000

# 可选：LLM 单价（USD / 百万 token）。不配置时只记录 token，不估算成本。
# LLM_INPUT_PRICE_PER_MILLION=0.14
# LLM_OUTPUT_PRICE_PER_MILLION=0.28
