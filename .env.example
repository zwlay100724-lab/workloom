# 根目录 .env：docker compose 的变量替换模板
#
#   cp .env.example .env
#
# 只用于 Docker Compose；本地直跑请用
# taskflow/.env.example 和 docmind/.env.example。
# 真实 .env 已被 .gitignore 忽略，绝不要提交。

# ── LLM（OpenAI 兼容接口，当前指向 DeepSeek）──
LLM_API_KEY=sk-replace-me
LLM_MODEL_ID=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5

# ── JWT（TaskFlow 签发，DocMind 复用同一 secret 验签）──
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# ── Embedding（DocMind，当前使用 DashScope）──
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_ID=text-embedding-v4
EMBED_API_KEY=sk-replace-me
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_DIMENSION=1024

# ── RAG 参数 ────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K=4

# ── 开发环境数据库密码（可选，不填用 compose 默认值）──
POSTGRES_TASKFLOW_PASSWORD=taskflow
POSTGRES_DOCMIND_PASSWORD=docmind

# 本地排查 SQL 时可临时 export DB_ECHO=true（不要写进 .env，
# 因为 Settings 默认 extra=forbid，未声明的键会导致启动失败）。
