# TaskFlow 本地直跑（不用 Docker）时的配置模板
#
#   cp taskflow/.env.example taskflow/.env
#
# 只包含 TaskFlow Settings 认识的字段；不要加入 EMBED_* 等 DocMind 字段，
# 因为 pydantic-settings 默认 extra=forbid，多余键会让服务启动失败。
# 真实 .env 已被 .gitignore 忽略，绝不要提交。

# 按你本地 PostgreSQL 的实际账号/密码修改
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0

# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

LLM_API_KEY=sk-replace-me
LLM_MODEL_ID=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
